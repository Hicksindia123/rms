# RMS backend environment (master plan §12.4).
# Copy to backend/.env and fill in values. backend/.env is git-ignored — never commit it.
# Local values come from `supabase start` output (Option A) or the rms-dev project (Option B).

# local | test | dev | prod. HS256 tokens and stack traces in error details: local/test only.
APP_ENV=local

# Postgres connection for the dedicated rms_api role (created by the P1-02 migrations without a
# password; set it as described in docs/SETUP.md "The rms_api database role"). Never use postgres.
#   Local (Option A):  postgresql+psycopg://rms_api:<password>@127.0.0.1:54322/postgres
#   Remote direct:     postgresql+psycopg://rms_api:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Remote pooler:     postgresql+psycopg://rms_api.<project-ref>:<password>@<pooler-host>:5432/postgres
# APP_ENV=prod REQUIRES ?sslmode=require (or verify-ca / verify-full); the API refuses to start
# without it. Production uses the Supabase session pooler (IPv4, port 5432): docs/DATABASE_MIGRATION_GUIDE.md §4.
# Per transaction the backend sets: SET LOCAL app.user_id = '<profile uuid>' (audit actor, created_by)
# and SET LOCAL app.request_id = '<request id>' (audit_log.request_id).
DATABASE_URL=
# Pool / timeouts (optional; defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# 0 disables. Sent as a libpq startup option; set 0 if a pooler in transaction mode rejects it.
DB_STATEMENT_TIMEOUT_MS=30000

SUPABASE_URL=
# Backend only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Local fallback for HS256 token verification (honoured only when APP_ENV is local/test).
SUPABASE_JWT_SECRET=
# Empty = {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Empty = {SUPABASE_URL}/auth/v1 (the `iss` claim Supabase Auth writes)
SUPABASE_JWT_ISSUER=
JWKS_CACHE_TTL_SECONDS=600

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=100
SIGNED_URL_TTL_SECONDS=600

# Optional email channel (Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Implicit TLS (port 465). Local Mailpit (supabase start): SMTP_HOST=127.0.0.1, SMTP_PORT=54325,
# SMTP_USE_TLS=false, SMTP_FROM=any address. Empty SMTP_HOST or SMTP_FROM = email channel disabled.
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
# Web app URL for deep links in notification emails.
APP_PUBLIC_URL=http://localhost:5173

TZ=Asia/Kolkata

# Tests: backend/tests read TEST_DATABASE_URL from the process environment (NOT from this file):
# a superuser URL of a LOCAL database with the migrations applied. Default when unset:
# postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres (local Supabase).

# One-time Super Admin bootstrap (backend/scripts/bootstrap_super_admin.py). Set in the shell for that
# single run only; outside local/test the script prompts when they are empty. Never keep them in a file.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=
