# RMS frontend environment (master plan §12.4).
# Copy to frontend/.env.local. Only VITE_* variables reach the browser bundle,
# so this file must only ever contain public values. Backend secrets stay in backend/.env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
